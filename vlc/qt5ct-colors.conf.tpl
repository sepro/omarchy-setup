# Qt5 colour scheme for qt5ct, generated from the active Omarchy theme.
# Read by ~/.config/qt5ct/qt5ct.conf, which only VLC is pointed at (see
# ~/.local/share/applications/vlc.desktop). Everything is derived from
# background / foreground / accent so it works for light and dark themes alike.
#
# Role order (QPalette): WindowText, Button, Light, Midlight, Dark, Mid, Text,
# BrightText, ButtonText, Base, Window, Shadow, Highlight, HighlightedText,
# Link, LinkVisited, AlternateBase, NoRole, ToolTipBase, ToolTipText,
# PlaceholderText. Colours are #AARRGGBB.

[ColorScheme]
active_colors=#ff{{ foreground_strip }}, #ff{{ mix_strip background foreground 10% }}, #ff{{ mix_strip background foreground 22% }}, #ff{{ mix_strip background foreground 16% }}, #ff{{ darker_background_strip }}, #ff{{ mix_strip background foreground 30% }}, #ff{{ foreground_strip }}, #ff{{ bright_foreground_strip }}, #ff{{ foreground_strip }}, #ff{{ dark_background_strip }}, #ff{{ background_strip }}, #ff{{ darker_background_strip }}, #ff{{ accent_strip }}, #ff{{ bright_foreground_strip }}, #ff{{ bright_blue_strip }}, #ff{{ magenta_strip }}, #ff{{ mix_strip dark_background foreground 6% }}, #ff000000, #ff{{ mix_strip background foreground 10% }}, #ff{{ foreground_strip }}, #ff{{ dark_foreground_strip }}
inactive_colors=#ff{{ foreground_strip }}, #ff{{ mix_strip background foreground 10% }}, #ff{{ mix_strip background foreground 22% }}, #ff{{ mix_strip background foreground 16% }}, #ff{{ darker_background_strip }}, #ff{{ mix_strip background foreground 30% }}, #ff{{ foreground_strip }}, #ff{{ bright_foreground_strip }}, #ff{{ foreground_strip }}, #ff{{ dark_background_strip }}, #ff{{ background_strip }}, #ff{{ darker_background_strip }}, #ff{{ selection_strip }}, #ff{{ bright_foreground_strip }}, #ff{{ bright_blue_strip }}, #ff{{ magenta_strip }}, #ff{{ mix_strip dark_background foreground 6% }}, #ff000000, #ff{{ mix_strip background foreground 10% }}, #ff{{ foreground_strip }}, #ff{{ dark_foreground_strip }}
disabled_colors=#ff{{ muted_strip }}, #ff{{ mix_strip background foreground 8% }}, #ff{{ mix_strip background foreground 22% }}, #ff{{ mix_strip background foreground 16% }}, #ff{{ darker_background_strip }}, #ff{{ mix_strip background foreground 30% }}, #ff{{ muted_strip }}, #ff{{ bright_foreground_strip }}, #ff{{ muted_strip }}, #ff{{ dark_background_strip }}, #ff{{ background_strip }}, #ff{{ darker_background_strip }}, #ff{{ muted_strip }}, #ff{{ dark_foreground_strip }}, #ff{{ muted_strip }}, #ff{{ muted_strip }}, #ff{{ mix_strip dark_background foreground 6% }}, #ff000000, #ff{{ mix_strip background foreground 10% }}, #ff{{ muted_strip }}, #ff{{ muted_strip }}
